[Unit]
Description=Agent Monitor — Claude session status on DeepDeck
# graphical-session.target is passive (RefuseManualStart=yes): order
# after it if it is in the same transaction, but never pull it in.
After=network-online.target graphical-session.target

[Service]
ExecStart=%h/.local/bin/agent-monitor daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
